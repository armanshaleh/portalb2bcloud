# Copy to .env.selfhost.local and fill in values from YOUR self-hosted backend.
# No real credentials are included. Do not commit the filled-in file.
# PostgreSQL alone is not enough: Auth, Data API and Storage are required.

# PUBLIC / BUILD TIME: visible to browsers. Changes require rebuilding Docker.
# HTTPS backend API URL reachable from browsers (not a PostgreSQL URL).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional identifier of your self-hosted backend.
VITE_SUPABASE_PROJECT_ID=

# PRIVATE / RUNTIME: pass with docker run --env-file, never with --build-arg.
# Backend API URL reachable from inside the application container.
SUPABASE_URL=
# Use the SAME public key as VITE_SUPABASE_PUBLISHABLE_KEY.
SUPABASE_PUBLISHABLE_KEY=
# Privileged key generated by YOUR self-hosted backend, not a Lovable Cloud key.
SUPABASE_SERVICE_ROLE_KEY=

# Generate separate random secrets, for example: openssl rand -hex 32
# Scheduler must send Authorization: Bearer <LOVABLE_CRON_SECRET>.
LOVABLE_CRON_SECRET=
# Optional old secret accepted during rotation; leave empty otherwise.
LOVABLE_CRON_SECRET_PREVIOUS=
# Optional until your real Uptime Kuma integration is connected.
UPTIME_KUMA_WEBHOOK_SECRET=

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Configure SMTP in your self-hosted Auth service, not in this application.
# Lovable-managed email templates/delivery are not automatically portable.
# No SMTP_* or DATABASE_URL variables are read by this application.